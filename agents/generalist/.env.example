# ==========================================
# Generalist Agent Configuration (.env)
# ==========================================

# --- Standalone Server Network Settings ---
PORT=8001
AGENT_HOST=0.0.0.0

# --- LLM API Provider Settings ---
# You can provide either a base URL (e.g. https://api.groq.com/openai/v1)
# or the full direct endpoint (e.g. https://api.groq.com/openai/v1/chat/completions).
# Both LLM_BASE_URL and LLM_API_URL are supported.
LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions

# Provider API Key (e.g. gsk_... for Groq, or your OpenAI / OpenRouter key)
LLM_API_KEY=your-api-key-here

# Model identifier
LLM_MODEL_NAME=openai/gpt-oss-20b
MODEL_TAG=groq/gpt-oss-20b

# --- Token & Execution Guardrails ---
LLM_MAX_TOKENS=4096
INTERNAL_TIMEOUT_SAFETY_BUFFER_SECONDS=2.0

# Optional Marketplace Secret (if enforced by runner)
WEBHOOK_SECRET=your-webhook-secret-here
